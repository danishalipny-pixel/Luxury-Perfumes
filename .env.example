# NOIRÉLLE Luxury Perfume E-Commerce — Environment Configuration Template
# Copy this file to .env for local development

# Application Configuration
VITE_APP_NAME="NOIRÉLLE"
VITE_APP_TAGLINE="A World Beyond Fragrance."
VITE_APP_URL="http://localhost:5174"

# WhatsApp Concierge Order Routing (E.164 international format without + or spaces)
VITE_WHATSAPP_PHONE="1234567890"

# Currency & Locale
VITE_CURRENCY_CODE="USD"
VITE_CURRENCY_SYMBOL="$"

# Analytics & Monitoring (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=""
